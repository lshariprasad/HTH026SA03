// ==========================================================
// BUZZER CONTROL
// ==========================================================
void beep(unsigned long duration)
{
  digitalWrite(BUZZER_PIN, HIGH);

  buzzerActive = true;
  buzzerStart = millis();
  buzzerDuration = duration;
}

void serviceBuzzer()
{
  if (!buzzerActive)
    return;

  if (millis() - buzzerStart >= buzzerDuration)
  {
    digitalWrite(BUZZER_PIN, LOW);
    buzzerActive = false;
  }
}

