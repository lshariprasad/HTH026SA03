// ==========================================================
// SEND CONTROL TO LIGHTING NODE
// ==========================================================
void sendLightingControl()
{
  char packet[80];

  if (manualMode)
  {
    snprintf(
      packet,
      sizeof(packet),
      "CONTROL,MANUAL,%d",
      manualBrightness
    );
  }
  else
  {
    snprintf(
      packet,
      sizeof(packet),
      "CONTROL,AUTO,0"
    );
  }

  udp.beginPacket(
    broadcastIP,
    UDP_PORT
  );

  udp.print(packet);

  udp.endPacket();

  Serial.print("CONTROL SENT: ");
  Serial.println(packet);
}

// ==========================================================
// RECEIVE UDP PACKETS
// ==========================================================
void receiveUDP()
{
  int packetSize = udp.parsePacket();

  if (packetSize <= 0)
    return;

  char packet[220];

  int len =
    udp.read(
      packet,
      sizeof(packet) - 1
    );

  if (len <= 0)
    return;

  packet[len] = '\0';

  Serial.print("UDP RX: ");
  Serial.println(packet);

  // ========================================================
  // ENERGY PACKET
  //
  // ENERGY,V,I,P,E,BATTERY,RSSI
  // ========================================================
  if (strncmp(packet, "ENERGY,", 7) == 0)
  {
    float v;
    float i;
    float p;
    float e;
    float b;
    int rssi;

    int result =
      sscanf(
        packet,
        "ENERGY,%f,%f,%f,%f,%f,%d",
        &v,
        &i,
        &p,
        &e,
        &b,
        &rssi
      );

    if (result == 6)
    {
      energyVoltage = v;
      energyCurrent = i;
      energyPower = p;
      energyConsumed = e;
      energyBattery = b;
      energyRSSI = rssi;

      energyNodeOnline = true;
      lastEnergyPacket = millis();

      Serial.println("Energy data updated.");

      // Short notification beep
      beep(40);
    }
  }

  // ========================================================
  // LIGHTING PACKET
  //
  // LIGHT,AMBIENT,MOTION,DISTANCE,BRIGHTNESS,
  // VIBRATION,LATENCY,SAVING,RSSI
  // ========================================================
  else if (strncmp(packet, "LIGHT,", 6) == 0)
  {
    float amb;
    int mot;
    float dist;
    int bright;
    int vib;
    int latency;
    float saving;
    int rssi;

    int result =
      sscanf(
        packet,
        "LIGHT,%f,%d,%f,%d,%d,%d,%f,%d",
        &amb,
        &mot,
        &dist,
        &bright,
        &vib,
        &latency,
        &saving,
        &rssi
      );

    if (result == 8)
    {
      ambientLight = amb;
      motionState = mot;
      distanceCM = dist;
      brightnessPercent = bright;
      vibrationState = vib;
      safetyLatency = latency;
      energySaving = saving;
      lightingRSSI = rssi;

      lightingNodeOnline = true;
      lastLightingPacket = millis();

      Serial.println("Lighting data updated.");

      // Buzzer for new motion event
      if (motionState == 1)
      {
        beep(80);
      }
    }
  }
}

