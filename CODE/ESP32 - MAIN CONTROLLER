// ==========================================================
// BUTTON HANDLING
// ==========================================================
void handleButtons()
{
  for (int i = 0; i < 4; i++)
  {
    bool currentState =
      digitalRead(buttonPins[i]);

    if (
      lastButtonState[i] == HIGH &&
      currentState == LOW
    )
    {
      if (i == 0)
        button1Action();

      else if (i == 1)
        button2Action();

      else if (i == 2)
        button3Action();

      else if (i == 3)
        button4Action();
    }

    lastButtonState[i] =
      currentState;
  }
}

// ==========================================================
// BLYNK - MANUAL BRIGHTNESS
// V28
// ==========================================================
BLYNK_WRITE(V28)
{
  int value = param.asInt();

  if (value < 20)
    value = 20;

  if (value > 100)
    value = 100;

  manualBrightness = value;

  Serial.print("Blynk Manual Brightness: ");
  Serial.println(manualBrightness);

  if (manualMode)
  {
    sendLightingControl();
  }
}

// ==========================================================
// BLYNK - AUTO/MANUAL
// V29
// ==========================================================
BLYNK_WRITE(V29)
{
  int value = param.asInt();

  manualMode = (value == 1);

  Serial.print("Blynk Mode: ");

  if (manualMode)
  {
    Serial.println("MANUAL");
  }
  else
  {
    Serial.println("AUTO");
  }

  sendLightingControl();

  updateTFT();
}

// ==========================================================
// BLYNK - RESET ENERGY
// V30
// ==========================================================
BLYNK_WRITE(V30)
{
  int value = param.asInt();

  if (value == 1)
  {
    energyConsumed = 0.0;

    Serial.println("Energy counter reset.");

    Blynk.virtualWrite(
      V4,
      energyConsumed
    );

    beep(200);

    updateTFT();
  }
}

// ==========================================================
// SEND ALL DATA TO BLYNK
// ==========================================================
void sendBlynkData()
{
  // --------------------------------------------------------
  // ENERGY
  // --------------------------------------------------------
  Blynk.virtualWrite(
    V0,
    energyVoltage
  );

  Blynk.virtualWrite(
    V1,
    energyCurrent
  );

  Blynk.virtualWrite(
    V2,
    energyPower
  );

  Blynk.virtualWrite(
    V3,
    (int)energyBattery
  );

  Blynk.virtualWrite(
    V4,
    energyConsumed
  );

  // --------------------------------------------------------
  // LIGHTING
  // --------------------------------------------------------
  Blynk.virtualWrite(
    V5,
    (int)ambientLight
  );

  Blynk.virtualWrite(
    V6,
    motionState
  );

  Blynk.virtualWrite(
    V7,
    distanceCM
  );

  Blynk.virtualWrite(
    V8,
    brightnessPercent
  );

  Blynk.virtualWrite(
    V9,
    vibrationState
  );

  // --------------------------------------------------------
  // SAFETY
  // --------------------------------------------------------
  Blynk.virtualWrite(
    V10,
    safetyLatency
  );

  Blynk.virtualWrite(
    V11,
    energySaving
  );

  // --------------------------------------------------------
  // SYSTEM STATUS
  // --------------------------------------------------------
  Blynk.virtualWrite(
    V24,
    "ONLINE"
  );

  Blynk.virtualWrite(
    V25,
    energyNodeOnline ? "ONLINE" : "OFFLINE"
  );

  Blynk.virtualWrite(
    V26,
    lightingNodeOnline ? "ONLINE" : "OFFLINE"
  );

  Blynk.virtualWrite(
    V27,
    manualMode ? "MANUAL" : "AUTO"
  );

  // Keep dashboard synchronized
  Blynk.virtualWrite(
    V28,
    manualBrightness
  );

  Blynk.virtualWrite(
    V29,
    manualMode ? 1 : 0
  );

  Serial.println("Blynk data updated.");
}

// ==========================================================
// CHECK NODE STATUS
// ==========================================================
void checkNodeStatus()
{
  unsigned long now = millis();

  // --------------------------------------------------------
  // Energy node timeout = 5 sec
  // --------------------------------------------------------
  if (
    energyNodeOnline &&
    now - lastEnergyPacket > 5000
  )
  {
    energyNodeOnline = false;

    Serial.println(
      "WARNING: ENERGY NODE OFFLINE"
    );

    beep(300);
  }

  // --------------------------------------------------------
  // Lighting node timeout = 5 sec
  // --------------------------------------------------------
  if (
    lightingNodeOnline &&
    now - lastLightingPacket > 5000
  )
  {
    lightingNodeOnline = false;

    Serial.println(
      "WARNING: LIGHTING NODE OFFLINE"
    );

    beep(300);
  }
}

// ==========================================================
// WIFI CHECK
// ==========================================================
void checkWiFi()
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println(
      "Wi-Fi disconnected. Reconnecting..."
    );

    WiFi.disconnect();

    WiFi.begin(
      ssid,
      pass
    );
  }
}

// ==========================================================
// BLYNK CONNECTED
// ==========================================================
BLYNK_CONNECTED()
{
  Serial.println(
    "Blynk Cloud connected."
  );

  // Get latest dashboard control values
  Blynk.syncVirtual(V28);
  Blynk.syncVirtual(V29);

  // Update status
  Blynk.virtualWrite(
    V24,
    "ONLINE"
  );
}

// ==========================================================
// SETUP
// ==========================================================
void setup()
{
  Serial.begin(115200);

  delay(500);

  Serial.println();
  Serial.println(
    "========================================"
  );
  Serial.println(
    " MAIN ESP32 CONTROL NODE"
  );
  Serial.println(
    " SMART ADAPTIVE STREET LIGHTING"
  );
  Serial.println(
    "========================================"
  );

  // --------------------------------------------------------
  // Buzzer
  // --------------------------------------------------------
  pinMode(
    BUZZER_PIN,
    OUTPUT
  );

  digitalWrite(
    BUZZER_PIN,
    LOW
  );

  // --------------------------------------------------------
  // Buttons
  // --------------------------------------------------------
  for (int i = 0; i < 4; i++)
  {
    pinMode(
      buttonPins[i],
      INPUT_PULLUP
    );
  }

  // --------------------------------------------------------
  // SPI
  // --------------------------------------------------------
  SPI.begin(
    TFT_SCLK,
    -1,
    TFT_MOSI,
    TFT_CS
  );

  // --------------------------------------------------------
  // TFT
  // --------------------------------------------------------
  tft.initR(
    INITR_BLACKTAB
  );

  tft.setRotation(1);

  tft.fillScreen(
    ST77XX_BLACK
  );

  tft.setTextColor(
    ST77XX_CYAN
  );

  tft.setTextSize(1);

  tft.setCursor(8, 35);
  tft.println(
    "SMART ADAPTIVE"
  );

  tft.setCursor(8, 50);
  tft.println(
    "STREET LIGHTING"
  );

  tft.setTextColor(
    ST77XX_WHITE
  );

  tft.setCursor(8, 70);
  tft.println(
    "Initializing..."
  );

  delay(500);

  // --------------------------------------------------------
  // Wi-Fi + Blynk
  // --------------------------------------------------------
  Serial.println(
    "Connecting Wi-Fi + Blynk..."
  );

  Blynk.begin(
    BLYNK_AUTH_TOKEN,
    ssid,
    pass
  );

  Serial.println(
    "Blynk initialization complete."
  );

  // --------------------------------------------------------
  // UDP
  // --------------------------------------------------------
  udp.begin(
    UDP_PORT
  );

  Serial.print(
    "UDP listening on port: "
  );

  Serial.println(
    UDP_PORT
  );

  Serial.print(
    "Main ESP32 IP: "
  );

  Serial.println(
    WiFi.localIP()
  );

  // --------------------------------------------------------
  // Timers
  // --------------------------------------------------------
  // Blynk recommends timer-based sending instead of
  // continuous virtualWrite() inside loop().
  timer.setInterval(
    2000L,
    sendBlynkData
  );

  timer.setInterval(
    1000L,
    checkNodeStatus
  );

  timer.setInterval(
    10000L,
    checkWiFi
  );

  // --------------------------------------------------------
  // Initial screen
  // --------------------------------------------------------
  currentPage = 0;

  updateTFT();

  beep(100);

  Serial.println(
    "MAIN CONTROL NODE READY."
  );
}

// ==========================================================
// LOOP
// ==========================================================
void loop()
{
  // Blynk service
  Blynk.run();

  // Blynk timers
  timer.run();

  // Receive Mini ESP32 data
  receiveUDP();

  // Buttons
  handleButtons();

  // Buzzer
  serviceBuzzer();

  // Keep display reasonably current
  static unsigned long lastDisplay = 0;

  if (millis() - lastDisplay >= 1000)
  {
    lastDisplay = millis();

    updateTFT();
  }
}
