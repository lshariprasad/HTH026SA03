bool readVibration()
{
  return (
    digitalRead(VIBRATION_PIN)
    == HIGH
  );
}

// ============================================================
// READ ULTRASONIC
// ============================================================

float readUltrasonic()
{
  digitalWrite(
    ULTRASONIC_TRIG,
    LOW
  );

  delayMicroseconds(2);

  digitalWrite(
    ULTRASONIC_TRIG,
    HIGH
  );

  delayMicroseconds(10);

  digitalWrite(
    ULTRASONIC_TRIG,
    LOW
  );

  unsigned long duration =
    pulseIn(
      ULTRASONIC_ECHO,
      HIGH,
      30000
    );

  if (duration == 0)
  {
    return 999.0;
  }

  float distance =
    duration * 0.0343 / 2.0;

  if (
    distance < 2 ||
    distance > 400
  )
  {
    return 999.0;
  }

  return distance;
}

// ============================================================
// DETERMINE NIGHT MODE
// ============================================================

void determineNightMode()
{
  /*
    This is a starting threshold.

    The actual threshold must be calibrated
    using the real LDR circuit.
  */

  float rawLDR =
    ambientLightPercent;

  /*
    Here we assume:

      Lower percentage = darker

    If your LDR circuit behaves in reverse,
    change this logic.
  */

  nightMode =
    rawLDR < 35.0;
}

// ============================================================
// PROCESS MOTION
// ============================================================

void processMotion()
{
  bool previousMotion =
    motionDetected;

  motionDetected =
    readPIR();

  // ========================================================
  // NEW MOTION EVENT
  // ========================================================

  if (
    motionDetected &&
    !previousMotion
  )
  {
    lastMotionTime =
      millis();

    // Start safety measurement
    motionStartTime =
      millis();

    measuringLatency = true;

    Serial.println();
    Serial.println(
      ">>> MOTION DETECTED"
    );
  }

  // ========================================================
  // MOTION STILL ACTIVE
  // ========================================================

  if (motionDetected)
  {
    lastMotionTime =
      millis();
  }
}

// ============================================================
// CALCULATE TARGET BRIGHTNESS
// ============================================================

void calculateTargetBrightness()
{
  // ========================================================
  // MANUAL MODE
  // ========================================================

  if (manualMode)
  {
    targetBrightness =
      manualBrightness;

    return;
  }

  // ========================================================
  // DAYTIME
  // ========================================================

  if (!nightMode)
  {
    targetBrightness =
      0;

    return;
  }

  // ========================================================
  // NIGHT + MOTION
  // ========================================================

  if (motionDetected)
  {
    targetBrightness =
      FULL_BRIGHTNESS;

    return;
  }

  // ========================================================
  // KEEP FULL BRIGHTNESS AFTER MOTION
  // ========================================================

  if (
    millis() - lastMotionTime
    < MOTION_HOLD_TIME
  )
  {
    targetBrightness =
      FULL_BRIGHTNESS;

    return;
  }

  // ========================================================
  // NIGHT + NO MOTION
  // ========================================================

  targetBrightness =
    idleBrightness;
}

// ============================================================
// UPDATE BRIGHTNESS
// ============================================================

void updateBrightness()
{
  /*
    Fast ramp-up when target brightness is 100%.
  */

  if (
    targetBrightness >
    currentBrightness
  )
  {
    int step = 15;

    currentBrightness += step;

    if (
      currentBrightness >
      targetBrightness
    )
    {
      currentBrightness =
        targetBrightness;
    }
  }

  /*
    Slower return to idle brightness.
  */

  else if (
    targetBrightness <
    currentBrightness
  )
  {
    int step = 5;

    currentBrightness -= step;

    if (
      currentBrightness <
      targetBrightness
    )
    {
      currentBrightness =
        targetBrightness;
    }
  }

  if (currentBrightness < 0)
    currentBrightness = 0;

  if (currentBrightness > 100)
    currentBrightness = 100;

  // Convert 0-100 to PWM 0-255

  int pwmValue =
    map(
      currentBrightness,
      0,
      100,
      0,
      255
    );

  ledcWrite(
    LED_PIN,
    pwmValue
  );
}

// ============================================================
// SAFETY LATENCY
// ============================================================

void checkSafetyLatency()
{
  if (
    measuringLatency &&
    currentBrightness >= 100
  )
  {
    safetyLatency =
      millis() -
      motionStartTime;

    measuringLatency = false;

    Serial.print(
      "SAFETY LATENCY: "
    );

    Serial.print(
      safetyLatency
    );

    Serial.println(
      " ms"
    );
  }
}

// ============================================================
// ENERGY SAVING ESTIMATE
// ============================================================

void calculateEnergySaving()
{
  /*
    This is an ESTIMATE based on brightness.

    It is not the final measured energy saving.

    Assuming full brightness is the baseline:

      Saving = 1 - average brightness / 100

    For the final hackathon result we should use
    actual electrical energy measurements.
  */

  float brightnessFraction =
    currentBrightness /
    100.0;

  estimatedEnergySaving =
    (1.0 -
     brightnessFraction) *
    100.0;

  if (
    estimatedEnergySaving < 0
  )
  {
    estimatedEnergySaving = 0;
  }

  if (
    estimatedEnergySaving > 100
  )
  {
    estimatedEnergySaving = 100;
  }
}

// ============================================================
// SEND DATA TO MAIN ESP32
// ============================================================

void sendLightingData()
{
  char packet[220];

  snprintf(
    packet,
    sizeof(packet),

    "LIGHT,%.0f,%d,%.1f,%d,%d,%d,%.1f,%d",

    ambientLightPercent,

    motionDetected ? 1 : 0,

    distanceCM,

    currentBrightness,

    vibrationDetected ? 1 : 0,

    safetyLatency,

    estimatedEnergySaving,

    WiFi.RSSI()
  );

  udp.beginPacket(
    broadcastIP,
    UDP_PORT
  );

  udp.print(packet);

  udp.endPacket();

  Serial.print(
    "LIGHT DATA SENT: "
  );

  Serial.println(packet);
}

// ============================================================
// RECEIVE MAIN ESP32 CONTROL
// ============================================================

void receiveControl()
{
  int packetSize =
    udp.parsePacket();

  if (packetSize <= 0)
    return;

  char packet[120];

  int len =
    udp.read(
      packet,
      sizeof(packet) - 1
    );

  if (len <= 0)
    return;

  packet[len] =
    '\0';

  Serial.print(
    "CONTROL RX: "
  );

  Serial.println(packet);

  // ========================================================
  // AUTO MODE
  // ========================================================

  if (
    strcmp(
      packet,
      "CONTROL,AUTO,0"
    ) == 0
  )
  {
    manualMode = false;

    Serial.println(
      "Lighting mode: AUTO"
    );

    return;
  }

  // ========================================================
  // MANUAL MODE
  //
  // CONTROL,MANUAL,VALUE
  // ========================================================

  if (
    strncmp(
      packet,
      "CONTROL,MANUAL,",
      15
    ) == 0
  )
  {
    int value =
      atoi(
        packet + 15
      );

    if (value < 0)
      value = 0;

    if (value > 100)
      value = 100;

    manualBrightness =
      value;

    manualMode =
      true;

    Serial.print(
      "Manual brightness = "
    );

    Serial.print(
      manualBrightness
    );

    Serial.println("%");
  }
}

// ============================================================
// LOCAL BRIGHTNESS BUTTON
// ============================================================

void handleAdjustButton()
{
  bool currentState =
    digitalRead(
      ADJUST_BUTTON
    );

  if (
    lastButtonState == HIGH &&
    currentState == LOW
  )
  {
    if (
      millis() -
      lastButtonPress >
      BUTTON_DEBOUNCE
    )
    {
      lastButtonPress =
        millis();

      /*
        Step through:

        20
        40
        60
        80
        100
        20
      */

      idleBrightness += 20;

      if (
        idleBrightness > 100
      )
      {
        idleBrightness = 20;
      }

      Serial.print(
        "Idle brightness set to "
      );

      Serial.print(
        idleBrightness
      );

      Serial.println("%");
    }
  }

  lastButtonState =
    currentState;
}

