void connectWiFi()
{
  Serial.println();
  Serial.println("Connecting to Wi-Fi...");

  WiFi.mode(WIFI_STA);

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  unsigned long startTime =
    millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - startTime < 20000
  )
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println();

  if (
    WiFi.status() ==
    WL_CONNECTED
  )
  {
    Serial.println(
      "Wi-Fi connected!"
    );

    Serial.print(
      "Lighting Node IP: "
    );

    Serial.println(
      WiFi.localIP()
    );

    Serial.print(
      "RSSI: "
    );

    Serial.println(
      WiFi.RSSI()
    );
  }
  else
  {
    Serial.println(
      "Wi-Fi connection FAILED"
    );
  }
}

// ============================================================
// READ LDR
// ============================================================

float readLDRPercent()
{
  const int samples = 10;

  long total = 0;

  for (
    int i = 0;
    i < samples;
    i++
  )
  {
    total += analogRead(LDR_PIN);

    delayMicroseconds(300);
  }

  float average =
    (float)total /
    samples;

  /*
    Convert ADC value to approximate
    ambient-light percentage.

    This mapping depends on the actual LDR
    circuit and must be calibrated.

    If your LDR voltage is opposite,
    reverse the mapping.
  */

  float percentage =
    (average /
     ADC_MAX) *
    100.0;

  if (percentage < 0)
    percentage = 0;

  if (percentage > 100)
    percentage = 100;

  return percentage;
}

// ============================================================
// READ POTENTIOMETER
// ============================================================

int readPotentiometer()
{
  const int samples = 10;

  long total = 0;

  for (
    int i = 0;
    i < samples;
    i++
  )
  {
    total += analogRead(POT_PIN);

    delayMicroseconds(300);
  }

  float average =
    (float)total /
    samples;

  /*
    Potentiometer controls idle brightness
    from 20% to 60%.
  */

  int value =
    map(
      (int)average,
      0,
      ADC_MAX,
      20,
      60
    );

  if (value < 20)
    value = 20;

  if (value > 60)
    value = 60;

  return value;
}

// ============================================================
// READ PIR
// ============================================================

bool readPIR()
{
  return (
    digitalRead(PIR_PIN)
    == HIGH
