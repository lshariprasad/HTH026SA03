  );

  Serial.println(
    " INTELLIGENT LIGHTING NODE"
  );

  Serial.println(
    "============================================"
  );

  // ========================================================
  // SENSOR PINS
  // ========================================================

  pinMode(
    LDR_PIN,
    INPUT
  );

  pinMode(
    POT_PIN,
    INPUT
  );

  pinMode(
    PIR_PIN,
    INPUT
  );

  pinMode(
    VIBRATION_PIN,
    INPUT
  );

  pinMode(
    ULTRASONIC_TRIG,
    OUTPUT
  );

  pinMode(
    ULTRASONIC_ECHO,
    INPUT
  );

  // ========================================================
  // BUTTON
  // ========================================================

  pinMode(
    ADJUST_BUTTON,
    INPUT_PULLUP
  );

  // ========================================================
  // ADC
  // ========================================================

  analogReadResolution(12);

  analogSetPinAttenuation(
    LDR_PIN,
    ADC_11db
  );

  analogSetPinAttenuation(
    POT_PIN,
    ADC_11db
  );

  // ========================================================
  // LED PWM
  // ========================================================

  ledcAttach(
    LED_PIN,
    PWM_FREQUENCY,
    PWM_RESOLUTION
  );

  ledcWrite(
    LED_PIN,
    0
  );

  // ========================================================
  // OLED
  // ========================================================

  Wire.begin(
    OLED_SDA,
    OLED_SCL
  );

  if (
    display.begin(
      SSD1306_SWITCHCAPVCC,
      0x3C
    )
  )
  {
    Serial.println(
      "OLED initialized."
    );

    display.clearDisplay();

    display.setTextColor(
      SSD1306_WHITE
    );

    display.setTextSize(1);

    display.setCursor(
      10,
      20
    );

    display.println(
      "LIGHTING NODE"
    );

    display.setCursor(
      10,
      35
    );

    display.println(
      "INITIALIZING..."
    );

    display.display();

    delay(1000);
  }
  else
  {
    Serial.println(
      "OLED not detected."
    );
  }

  // ========================================================
  // WIFI
  // ========================================================

  connectWiFi();

  // ========================================================
  // UDP
  // ========================================================

  udp.begin(
    UDP_PORT
  );

  Serial.print(
    "UDP listening on port "
  );

  Serial.println(
    UDP_PORT
  );

  // ========================================================
  // START VALUES
  // ========================================================

  idleBrightness =
    readPotentiometer();

  currentBrightness =
    0;

  targetBrightness =
    0;

  Serial.println();
  Serial.println(
    "LIGHTING NODE READY."
  );

  printStatus();
}

// ============================================================
// LOOP
// ============================================================

void loop()
{
  unsigned long now =
    millis();

  // ========================================================
  // RECEIVE MAIN ESP32 COMMANDS
  // ========================================================

  receiveControl();

  // ========================================================
  // READ SENSORS
  // ========================================================

  if (
    now - lastSensorRead >=
    SENSOR_INTERVAL
  )
  {
    lastSensorRead =
      now;

    // LDR
    ambientLightPercent =
      readLDRPercent();

    // POT
    if (!manualMode)
    {
      idleBrightness =
        readPotentiometer();
    }

    // PIR
    processMotion();

    // Vibration
    vibrationDetected =
      readVibration();

    // Ultrasonic
    distanceCM =
      readUltrasonic();

    // Determine day/night
    determineNightMode();
  }

  // ========================================================
  // LOCAL BUTTON
  // ========================================================

  handleAdjustButton();

  // ========================================================
  // CONTROL LOGIC
  // ========================================================

  calculateTargetBrightness();

  // ========================================================
  // BRIGHTNESS
  // ========================================================

  updateBrightness();

  // ========================================================
  // SAFETY
  // ========================================================

  checkSafetyLatency();

  // ========================================================
  // ENERGY SAVING ESTIMATE
  // ========================================================

  calculateEnergySaving();

  // ========================================================
  // SEND TO MAIN ESP32
  // ========================================================

  if (
    now - lastSendTime >=
    SEND_INTERVAL
  )
  {
    lastSendTime =
      now;

    if (
      WiFi.status() ==
      WL_CONNECTED
    )
    {
      sendLightingData();
    }
  }

  // ========================================================
  // OLED
  // ========================================================

  if (
    now - lastOLEDUpdate >=
    OLED_INTERVAL
  )
  {
    lastOLEDUpdate =
      now;

    updateOLED();
  }

  // ========================================================
  // WIFI
  // ========================================================

  if (
    now - lastWiFiCheck >=
    WIFI_CHECK_INTERVAL
  )
  {
    lastWiFiCheck =
      now;

    if (
      WiFi.status() !=
      WL_CONNECTED
    )
    {
      connectWiFi();
    }
  }

  // ========================================================
  // SERIAL DEBUG
  // ========================================================

  static unsigned long lastDebug =
    0;

  if (
    now - lastDebug >=
    3000
  )
  {
    lastDebug =
      now;

    printStatus();
  }

  delay(5);
}
